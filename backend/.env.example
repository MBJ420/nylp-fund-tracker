# ─────────────────────────────────────────────────────────────────────────────
# FundTracker Advanced — Environment Variables Template
# NYLP Hackathon Submission
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file and rename the copy to: backend/.env
#   2. Fill in your FundTracker AI keys below (Qwen / DashScope or Google Gemini)
#   3. NEVER commit the .env file — it is in .gitignore!
# ─────────────────────────────────────────────────────────────────────────────

# FundTracker AI: Qwen LLM API Configuration (OpenAI-compatible DashScope endpoint)
# Powers: FMR PDF Parser, Macroeconomic News Sentiment & Portfolio Diagnostics
DASHSCOPE_API_KEY=your_qwen_api_key_here
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# FundTracker AI: Google Gemini API Configuration (Fallback / Alternative)
# If Qwen key is not provided, the system seamlessly falls back to Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Key for Local JWT Authentication
SECRET_KEY=fundtracker_secret_key_change_in_prod

